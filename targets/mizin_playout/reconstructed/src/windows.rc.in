#include <winver.h>
IDI_ICON1 ICON DISCARDABLE "@CMAKE_CURRENT_SOURCE_DIR@/assets/mizin-playout.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @MIZIN_VERSION_NUMERIC@
 PRODUCTVERSION @MIZIN_VERSION_NUMERIC@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "Mizin\0"
   VALUE "FileDescription", "Mizin Playout - Windows Preview\0"
   VALUE "FileVersion", "@MIZIN_VERSION@\0"
   VALUE "InternalName", "MizinPlayout\0"
   VALUE "OriginalFilename", "MizinPlayout.exe\0"
   VALUE "ProductName", "Mizin Playout\0"
   VALUE "ProductVersion", "@MIZIN_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END

# Copie para .env e preencha antes de "docker compose -f docker-compose.homeassistant.yml up -d".
# Nunca commitar o .env de verdade (já está no .gitignore deste alvo).

TZ=America/Sao_Paulo

# Usuário/senha do broker MQTT. A senha vira o conteúdo do arquivo mosquitto/passwd via bootstrap.sh
# (não editar passwd à mão -- ele guarda um hash, não a senha em texto puro).
MIZIN_MQTT_USERNAME=mizin
MIZIN_MQTT_PASSWORD=troque-isto-por-uma-senha-forte

# Onde a ponte MQTT encontra o portal Mizin Home. Duas opções:
#   - Pelo túnel Cloudflare público (funciona sem nenhuma mudança no NAS, é o default seguro):
#       MIZIN_PORTAL_URL=https://homecams.pages.dev
#   - Direto na LAN, se/quando uma porta do portal for liberada só para esta máquina (menor atraso,
#     não depende de internet -- ver README.md "Alcançar o portal no NAS"):
#       MIZIN_PORTAL_URL=http://192.168.1.XXX:19860
MIZIN_PORTAL_URL=https://homecams.pages.dev

# O MESMO token gerado do lado do portal/NAS por:
#   node targets/tuya_smartlife/scripts/generate-mqtt-bridge-token.mjs
# Copie o campo "token" de targets/tuya_smartlife/runtime/mqtt-bridge-token.json para cá -- o arquivo
# em si é gitignored e nunca sai da máquina onde foi gerado, só o valor do token viaja (por um canal
# que você controla: SSH, copiar o .env manualmente, etc. -- nunca por commit ou chat).
MIZIN_MQTT_BRIDGE_TOKEN=cole-aqui-o-token-gerado-no-portal

// Resource script for Plugnex.exe: application icon (shown in
// Explorer/taskbar, per the brand kit's 03_Icones/plugnex.ico) and
// version info. Version numeric fields are overridden at build time by
// build.ps1 the same way package.ps1 generated BuildConfig.cs's
// AssemblyVersion for the earlier C# client, from this target's own
// VERSION file (vX.Y.Z (build XXXX)).
//
// winres.h is required so the VS_VERSION_INFO/VS_FF_*/VOS_* identifiers
// below resolve to their numeric values (VS_VERSION_INFO is #define'd to
// 1 there); without it rc.exe silently compiles a resource literally
// NAMED the string "VS_VERSION_INFO" instead of resource ID 1, which
// links fine but is then invisible to GetFileVersionInfo/.NET's
// FileVersionInfo, which both look up the version resource by numeric ID.
#include <winres.h>
#include "../src/resource_ids.h"

1 ICON "plugnex.ico"

// Horizontal color logo (public/assets/brand/02_Logos/plugnex-horizontal-color.png),
// embedded as raw PNG bytes and decoded at runtime via GDI+ for the header
// bar, matching the prototype's <img class="logo"> (see visual/).
IDR_LOGO_HORIZONTAL RCDATA "logo-horizontal.png"

#ifndef PLUGNEX_VER_MAJOR
#define PLUGNEX_VER_MAJOR 1
#endif
#ifndef PLUGNEX_VER_MINOR
#define PLUGNEX_VER_MINOR 0
#endif
#ifndef PLUGNEX_VER_PATCH
#define PLUGNEX_VER_PATCH 0
#endif
#ifndef PLUGNEX_VER_BUILD
#define PLUGNEX_VER_BUILD 0
#endif
#ifndef PLUGNEX_VER_STRING
#define PLUGNEX_VER_STRING "1.0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PLUGNEX_VER_MAJOR,PLUGNEX_VER_MINOR,PLUGNEX_VER_PATCH,PLUGNEX_VER_BUILD
 PRODUCTVERSION PLUGNEX_VER_MAJOR,PLUGNEX_VER_MINOR,PLUGNEX_VER_PATCH,PLUGNEX_VER_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PLUGNEX"
            VALUE "FileDescription", "PLUGNEX - gerenciador de plugins e licencas"
            VALUE "FileVersion", PLUGNEX_VER_STRING
            VALUE "InternalName", "Plugnex.exe"
            VALUE "LegalCopyright", "PLUGNEX"
            VALUE "OriginalFilename", "Plugnex.exe"
            VALUE "ProductName", "PLUGNEX"
            VALUE "ProductVersion", PLUGNEX_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
